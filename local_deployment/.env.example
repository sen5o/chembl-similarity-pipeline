# Copy to .env and fill in. .env is gitignored.
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.0
TEAMS_WEBHOOK_URL=

# ChEMBL release the pipeline is pinned to. Pinned to 35 (not the latest)
# because cx_logp and molecular_species — required by the brief (6a) — exist
# only through ChEMBL 35 and were removed in later releases.
CHEMBL_RELEASE=35
