# Copy to .env and adjust. .env is gitignored; this file is not, so it holds
# only non-secret defaults. The one real secret (the Teams webhook) stays empty.

AIRFLOW_IMAGE_NAME=

# Optional. A Power Automate incoming-webhook URL is a credential — anyone
# holding it can post to the channel — so it is never committed. Leave blank to
# disable failure notifications; the callback logs and moves on.
TEAMS_WEBHOOK_URL=

# ChEMBL release the pipeline is pinned to. 35, not the latest: cx_logp and
# molecular_species — required by the brief (6a) — exist only through release 35
# and were removed afterwards.
CHEMBL_RELEASE=

# Course S3 bucket and the prefixes this project reads from and writes to.
# Not credentials: access is granted by the SSO profile below, not by knowing
# these names. Note the input prefix uses a hyphen and the output an underscore.
DE_SCHOOL_S3_BUCKET=
S3_ROOT_PREFIX=
INPUT_S3_PREFIX=

# The AWS profile NAME. The credentials themselves live in ~/.aws on the host
# and are mounted into task containers at run time — they are never in the repo.
# Run `aws sso login --profile De-School-students` before triggering the DAG.
AWS_PROFILE=
AWS_REGION=

# How many slices the corpus is split into for parallel fingerprinting.
CORPUS_PARTITIONS=

# CHANGE THIS: your HOST home directory, not a path inside a container.
# DockerOperator's bind mounts (~/.aws for credentials, ~/.data for the cached
# ChEMBL dump) are resolved by the host docker daemon, so expanding ~ inside the
# scheduler would wrongly yield /home/airflow.
HOST_HOME=

# Compose's default network, which task containers join to reach `postgres`.
# It is <project-directory>_default unless overridden. Confirm with:
#   docker network ls
TASK_DOCKER_NETWORK=
