# Copy to .env and fill in. .env is gitignored.
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.0
TEAMS_WEBHOOK_URL=

# ChEMBL release the pipeline is pinned to. Pinned to 35 (not the latest)
# because cx_logp and molecular_species — required by the brief (6a) — exist
# only through ChEMBL 35 and were removed in later releases.
CHEMBL_RELEASE=35

# S3 bucket and the prefixes this project reads from / writes to.
DE_SCHOOL_S3_BUCKET=
S3_ROOT_PREFIX=
INPUT_S3_PREFIX=
AWS_PROFILE=
AWS_REGION=

# How many slices the corpus is split into for parallel fingerprinting.
CORPUS_PARTITIONS=16

# Your HOST home directory — NOT a path inside a container. DockerOperator's
# bind mounts (~/.aws for SSO credentials, ~/.data for the cached ChEMBL dump)
# are resolved by the host docker daemon.
HOST_HOME=

# Compose's default network, used by task containers to reach `postgres`.
# Confirm with: docker network ls
TASK_DOCKER_NETWORK=
